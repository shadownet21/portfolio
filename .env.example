# Public production URL, required for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery by email (Resend). Required on Vercel, whose file system is read-only.
# Without these three variables, messages are saved locally to data/contact-messages.json.
RESEND_API_KEY=
# Inbox that receives the messages (never exposed to the browser).
CONTACT_EMAIL=
# Sender on a domain verified in Resend, e.g. Portfolio <contact@example.com>.
CONTACT_FROM_EMAIL=
